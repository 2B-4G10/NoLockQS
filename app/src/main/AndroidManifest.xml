<?xml version="1.0" encoding="utf-8"?>
<!-- The framework finds the module through src/main/resources/META-INF/xposed, and Vector lists it
     with its android:label and android:description. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Alerts for blocked attempts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NoLockApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoLockQS">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reports from the hooks in System UI and System Framework (see Reports). Only senders
             holding STATUS_BAR_SERVICE, which no ordinary app can, reach it. It also runs before
             the first unlock after a restart. -->
        <receiver
            android:name=".ReportReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="io.github.i2B4G10.NoLockQS.action.BLOCKED" />
                <action android:name="io.github.i2B4G10.NoLockQS.action.STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
