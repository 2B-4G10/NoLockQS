# Only applies if optimization is enabled in app/build.gradle.kts (it is off today).

# The Xposed framework instantiates the module entry named in META-INF/xposed/java_init.list.
-keep class com.example.nolockqs.NoLockXposedModule { <init>(); }

# The module hooks this method by name to report that it is active.
-keepclassmembers class com.example.nolockqs.MainActivity {
    public boolean isModuleActive();
}
