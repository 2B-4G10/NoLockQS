<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind everything: a calm base with three soft glows that show through the glass cards. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_base" />
        </shape>
    </item>
    <item
        android:width="460dp"
        android:height="460dp"
        android:gravity="top|start"
        android:left="-160dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="50%"
                android:startColor="@color/glass_glow_violet"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="420dp"
        android:height="420dp"
        android:gravity="center_vertical|end"
        android:right="-180dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="50%"
                android:startColor="@color/glass_glow_teal"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="460dp"
        android:height="460dp"
        android:bottom="-140dp"
        android:gravity="bottom|start"
        android:left="-120dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="50%"
                android:startColor="@color/glass_glow_pink"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
